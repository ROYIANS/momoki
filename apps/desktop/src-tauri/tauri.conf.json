{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Momoki",
  "mainBinaryName": "momoki",
  "version": "0.1.6",
  "identifier": "design.tulai.momoki",
  "build": {
    "frontendDist": "../dist/normal"
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "默默 Momoki",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: http://127.0.0.1:*; worker-src 'self' blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
