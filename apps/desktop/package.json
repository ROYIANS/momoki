{
  "name": "@momoki/desktop",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@momoki/studio": "workspace:*",
    "@momoki/agent-providers": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "lamejs": "1.2.1",
    "@vitejs/plugin-react": "^5.0.2",
    "@tailwindcss/vite": "^4.1.13",
    "vite": "^7.1.5",
    "typescript": "^5.9.2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "10.12.0",
    "knip": "6.40.0"
  },
  "scripts": {
    "types": "node ../../tooling/build-agent-packages.mjs && tsc --project tsconfig.json --noEmit",
    "lint": "eslint --config eslint.config.mjs scripts ui --max-warnings 0",
    "quality": "knip --config knip.json --no-progress",
    "test:parity": "node scripts/generate-contract-fixture.mjs --check && node scripts/tools.mjs cargo test --manifest-path src-tauri/Cargo.toml --locked --test portable_contract",
    "test:native": "node scripts/tools.mjs cargo test --manifest-path src-tauri/Cargo.toml --locked --features test-hooks",
    "test:native-gates": "node scripts/native-regression.mjs",
    "build:native": "node scripts/tools.mjs cargo build --manifest-path src-tauri/Cargo.toml --locked --release",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:app": "node scripts/build-app.mjs",
    "test:packaged": "node scripts/packaged-regression.mjs",
    "test:native-locks": "node scripts/native-locks-regression.mjs",
    "test:native-tavily": "node scripts/native-tavily-regression.mjs",
    "measure": "node scripts/measure.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:release": "node --test scripts/*.test.mjs ../../tooling/release-smoke-support.test.mjs"
  }
}
