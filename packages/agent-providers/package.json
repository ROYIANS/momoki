{
  "name": "@momoki/agent-providers",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "types": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../tooling/build-agent-packages.mjs && node ../../node_modules/vitest/vitest.mjs run --root ../.. packages/agent-providers/src"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@momoki/agent-core": "workspace:*"
  }
}
