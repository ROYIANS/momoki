{
  "name": "momoki",
  "private": true,
  "license": "MIT",
  "version": "0.1.7",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @momoki/web dev",
    "build": "node tooling/build-web.mjs",
    "test": "node tooling/build-agent-packages.mjs && vitest run",
    "preview": "vite preview --outDir dist",
    "landing:budget": "node tooling/landing-budget.mjs",
    "lint": "node tooling/build-agent-packages.mjs && tsc -b --pretty false",
    "quality": "node tooling/build-agent-packages.mjs && node tooling/quality-check.mjs",
    "quality:self-test": "node tooling/quality/self-test.mjs && node --test tooling/workspace.test.mjs tooling/studio.test.mjs tooling/agent-packages.test.mjs",
    "test:browser:agent-parallel-details": "node tooling/agent-parallel-details-browser.mjs",
    "test:storage:native": "node tooling/native-storage-regression.mjs",
    "models-dev:baseline": "node tooling/models-dev-baseline.mjs generate",
    "models-dev:verify": "node tooling/models-dev-baseline.mjs verify",
    "dev:site": "pnpm --filter @momoki/site dev",
    "workspace:check": "node tooling/workspace.mjs",
    "agent:build": "node tooling/build-agent-packages.mjs",
    "agent:example:check": "node tooling/agent-example-check.mjs"
  },
  "devDependencies": {
    "@lobehub/fluent-emoji": "^4.1.1",
    "@lobehub/icons": "^5.18.0",
    "@lobehub/ui": "^5.47.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-router": "^1.131.50",
    "antd": "^6.6.4",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "jszip": "^3.10.1",
    "motion": "^12.43.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.8",
    "zod": "^3.25.76",
    "@eslint/js": "10.0.1",
    "@opencode-ai/models": "0.0.104",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "26.1.0",
    "knip": "6.40.0",
    "lucide-react": "0.544.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.71.1",
    "vite": "^7.1.5",
    "vitest": "^5.0.1",
    "@momoki/distribution": "workspace:*",
    "@momoki/agent-core": "workspace:*"
  },
  "dependencies": {
    "@momoki/agent-providers": "workspace:*"
  }
}
