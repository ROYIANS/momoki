{
  "$schema": "https://unpkg.com/knip@6.40.0/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tooling/native-product-fixture.mjs",
        "tooling/native-product-fixture-check.mjs",
        "tooling/release-product-smoke.mjs",
        "tooling/release-smoke-support.test.mjs",
        "tooling/prepare-native-test-probe.mjs",
        "tooling/prepare-native-test-probe.test.mjs",
        "tooling/*-browser-regression.mjs",
        "tooling/mcp-management-browser.mjs",
        "tooling/e06-*.mjs",
        "tests/**/*.test.{ts,tsx}",
        "tests/typecheck/agentToolDefinition.ts",
        "tests/typecheck/agentResourceContracts.ts",
        "tests/fixtures/*/index.html",
        "tests/fixtures/*/harness.{ts,tsx}",
        "tests/fixtures/sourceSnapshots/e04-library/src/components/studio/AssetLibraryPages.tsx",
        "tooling/e07-draft-rebase-browser.mjs",
        "tooling/build-web.mjs",
        "tooling/assemble-web.mjs",
        "tooling/workspace.mjs",
        "tooling/quality-check.mjs",
        "tooling/quality/self-test.mjs",
        "tooling/studio.test.mjs",
        "tooling/workspace.test.mjs",
        "tooling/agent-packages.test.mjs",
        "tooling/agent-example-check.mjs",
        "tooling/e11-background-browser.mjs"
      ],
      "project": [
        "tooling/**/*.{mjs,mts,ts}"
      ],
      "typescript": {
        "config": [
          "tsconfig.json",
          "tests/typecheck/tsconfig.agent-source.json",
          "tests/typecheck/tsconfig.studio-agent-source.json",
          "tests/typecheck/tsconfig.desktop-media-source.json",
          "tests/typecheck/tsconfig.installable-skills-source.json",
          "tests/typecheck/tsconfig.mcp-source.json",
          "tests/typecheck/tsconfig.agent-background-source.json"
        ]
      },
      "vitest": {
        "entry": [
          "vitest.agent-source.config.ts",
          "vitest.studio-source.config.ts",
          "vitest.desktop-media-source.config.ts",
          "vitest.installable-skills-source.config.ts",
          "vitest.mcp-source.config.ts",
          "vitest.agent-background-source.config.ts"
        ]
      },
      "paths": {
        "@/components/studio/CoverCard": [
          "./packages/studio/src/features/library/ui/CoverCard.tsx"
        ],
        "@momoki/agent-core": [
          "./packages/agent-core/src/index.ts"
        ],
        "@momoki/agent-providers": [
          "./packages/agent-providers/src/index.ts"
        ],
        "@momoki/agent-providers/http": [
          "./packages/agent-providers/src/http/index.ts"
        ]
      }
    },
    "apps/web": {
      "entry": [
        "src/main.tsx!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!"
      ]
    },
    "apps/site": {
      "entry": [
        "src/main.tsx!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!"
      ]
    },
    "packages/studio": {
      "entry": [
        "src/app/bootstrap.tsx!",
        "src/features/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,mts,mjs}!"
      ],
      "tanstack-router": {
        "entry": [
          "src/app/routeTree.gen.ts!"
        ]
      }
    },
    "packages/distribution": {
      "entry": [],
      "project": [
        "src/**/*.{ts,tsx}!"
      ]
    },
    "apps/desktop": {
      "entry": [
        "scripts/contract-oracle.ts!",
        "scripts/fixture-audio.ts!",
        "ui/main.tsx",
        "ui/tavilyProbeMain.tsx",
        "ui/e11-background/index.html",
        "ui/e11Background.ts",
        "scripts/e11-background-probe.mjs",
        "scripts/prepare-release.mjs",
        "scripts/configure-hosted-tools.mjs",
        "scripts/finalize-release.mjs",
        "scripts/collect-release.mjs",
        "scripts/select-release-artifacts.mjs",
        "scripts/publish-draft.mjs",
        "scripts/release-native-checks.mjs",
        "scripts/run-release-smokes.mjs",
        "scripts/*.test.mjs",
        "src/main.tsx!"
      ],
      "project": [
        "scripts/**/*.{ts,mjs}",
        "ui/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}!"
      ],
      "includeEntryExports": false
    },
    "packages/agent-core": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts!"
      ],
      "includeEntryExports": true
    },
    "packages/agent-providers": {
      "entry": [
        "src/index.ts",
        "src/http/index.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts!"
      ],
      "includeEntryExports": true
    },
    "examples/agent-todo": {
      "entry": [
        "src/cli.ts",
        "src/conformance.test.ts"
      ],
      "project": [
        "src/**/*.ts!"
      ]
    }
  },
  "includeEntryExports": true
}
